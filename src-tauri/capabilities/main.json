{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main window may call the enumerated application service commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-send-chat",
    "allow-cancel-chat",
    "allow-application-view",
    "allow-save-provider",
    "allow-save-provider-timeouts",
    "allow-delete-provider",
    "allow-reorder-providers",
    "allow-save-profile",
    "allow-save-first-cloud-order",
    "allow-probe-provider",
    "allow-cancel-probe",
    "allow-save-team",
    "allow-publish-team",
    "allow-set-team-enabled",
    "allow-delete-team",
    "allow-delete-profile",
    "allow-save-gateway",
    "allow-initialize-gateway-token",
    "allow-reveal-gateway-token",
    "allow-revoke-access",
    "allow-rotate-gateway-token",
    "allow-start-gateway",
    "allow-stop-gateway",
    "allow-apply-gateway",
    "allow-quit-application",
    "allow-confirm-quit",
    "allow-diagnostics-view",
    "allow-usage-requests",
    "allow-usage-details",
    "allow-usage-summary",
    "allow-recover-usage",
    "allow-usage-context",
    "allow-save-budget",
    "allow-delete-budget",
    "allow-usage-budgets",
    "allow-prepare-usage-clear",
    "allow-clear-usage",
    "allow-recover-initialization",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-theme",
    "core:window:allow-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
